# ────────────────────────────────────────────────────────────
#  ARENA USA — environment variables
#  Copy to .env.local (Next.js) or set in Vercel Project Settings.
#  NEVER commit your real .env file to GitHub.
# ────────────────────────────────────────────────────────────

# Database — SQLite for local dev (file path), PostgreSQL for production.
# Local:
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Production (Vercel + Neon/Supabase/Railway):
# DATABASE_URL="postgresql://user:pass@host:5432/arena_usa?sslmode=require"

# Admin bootstrap (optional). On first request to /api/admin/login,
# a default admin user is created from these credentials.
ADMIN_EMAIL="admin@arena-usa.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Arena Admin"

# Public site URL — used for absolute URLs, sitemap, OpenGraph.
# Update this to your Vercel deployment URL before going live.
NEXT_PUBLIC_SITE_URL="https://arena-usa.vercel.app"

# ─── Phase 2: Vercel Cron authentication ─────────────────────
# Required for /api/cron/poll and /api/cron/distribute.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel → Settings → Cron Jobs → CRON_SECRET.
CRON_SECRET="generate-a-32-byte-random-string"

# Set to "true" to auto-publish RSS items that pass moderation & confidence > 0.7.
# Default: false (all RSS items land in PENDING for editor review).
AUTO_PUBLISH_FROM_RSS="false"

# ─── Phase 2: AI provider (z-ai-web-dev-sdk) ─────────────────
# When set, LLM-powered summarization & classification is used.
# When unset, the platform falls back to extractive heuristics.
# ZAI_API_KEY=""

# ─── Phase 2: Telegram bot tokens ─────────────────────────────
# Each TelegramDestination row stores the NAME of the env var,
# never the raw token. Add one env var per bot.
# TELEGRAM_BOT_1_TOKEN=""
# TELEGRAM_BOT_2_TOKEN=""

# ─── Phase 2: Pinterest API ───────────────────────────────────
# PINTEREST_API_TOKEN=""

# ─── Phase 2: Stripe (ad campaigns) ───────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Phase 2: SMTP (password reset emails) ────────────────────
# In dev, emails are logged to the server console.
# In production, set these to enable real email delivery.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="ARENA USA <noreply@arena-usa.com>"

# ─── Legacy / future integrations ─────────────────────────────
# Market data provider (e.g. Alpha Vantage, Finnhub). CoinGecko is free, no key needed.
# MARKET_DATA_API_KEY=""

# Weather provider (e.g. OpenWeatherMap). Open-Meteo is free, no key needed.
# WEATHER_API_KEY=""

# AdSense client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# NEXT_PUBLIC_ADSENSE_CLIENT=""
