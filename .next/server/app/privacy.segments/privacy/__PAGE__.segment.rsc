children":[["$","h1",null,{"className":"font-serif text-3xl sm:text-4xl font-bold text-foreground mb-3","children":"Privacy Policy"}],["$","p",null,{"className":"text-sm text-muted-foreground","children":[["$","strong",null,{"className":"text-foreground","children":"Effective Date:"}]," ","October 30, 2026",["$","br",null,{}],["$","strong",null,{"className":"text-foreground","children":"Last Updated:"}]," ","October 30, 2026"]}]]}],["$","div",null,{"className":"prose-legal text-foreground/90 leading-relaxed space-y-6 text-sm sm:text-base","children":[["$","p",null,{"className":"text-base","children":"ARENA USA (\"we\", \"us\", \"our\", or \"the Service\") is an AI-powered digital media platform operated by ARENA USA Technology. We are committed to protecting your privacy and complying with all applicable U.S. federal and state privacy laws, including the California Consumer Privacy Act (\"CCPA\"), the Children's Online Privacy Protection Act (\"COPPA\"), the CAN-SPAM Act, and similar state privacy statutes in Virginia, Colorado, Connecticut, Utah, and other jurisdictions."}],["$","p",null,{"className":"text-base","children":"This Privacy Policy explains what personal information we collect, how we use it, who we share it with, and the choices and rights you have regarding your data."}],["$","section",null,{"id":"information-we-collect","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"1. Information We Collect"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":["We collect information in the following categories. The specific categories of personal information we collect under the CCPA are listed in"," ",["$","a",null,{"href":"#ccpa-categories","className":"text-amber-glow hover:underline","children":"Section 11 (CCPA Disclosure)"}],"."]}],["$","h3",null,{"className":"font-serif text-lg font-bold text-foreground mt-4 mb-2","children":"1.1 Information You Provide Directly"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Account information:"}]," When you register as an editor or administrator, we collect your email address, name, and a password (stored as a PBKDF2 hash, never in plaintext)."]}],"$L5","$L6","$L7","$L8","$L9"]}],"$La","$Lb","$Lc","$Ld","$Le"]}]]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]]}],"$L1f"]}],["$L20"],"$L21"]}],"loading":null,"isPartial":false}
5:["$","li",null,{"children":[["$","strong",null,{"children":"Article submissions:"}]," If you submit content through our public API or admin panel, we collect the article title, body text, source URL, cover image, and metadata you provide."]}]
6:["$","li",null,{"children":[["$","strong",null,{"children":"Image uploads:"}]," When you upload cover images via the admin panel, we store the image file (or a URL to it) along with alt text for accessibility."]}]
7:["$","li",null,{"children":[["$","strong",null,{"children":"Password reset requests:"}]," If you request a password reset, we generate a one-time token (hashed with SHA-256) that is valid for 1 hour and sent to your email address."]}]
8:["$","li",null,{"children":[["$","strong",null,{"children":"Advertising inquiries:"}]," If you contact us about advertising, we collect your name, email address, company, and campaign details."]}]
9:["$","li",null,{"children":[["$","strong",null,{"children":"Donation information:"}]," We display cryptocurrency wallet addresses for donations. We do not collect or store donor information — transactions occur directly on the blockchain. We may display a public thank-you list of wallet addresses that have donated, but we do not link wallets to individuals."]}]
a:["$","h3",null,{"className":"font-serif text-lg font-bold text-foreground mt-4 mb-2","children":"1.2 Information Collected Automatically"}]
b:["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Usage data:"}]," When you visit our site, we collect your IP address, browser type, device type, referring URL, pages viewed, and time spent on pages. We use this to count active visitors (displayed in the header) and to understand aggregate traffic patterns."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Cookies and similar technologies:"}]," We use a single essential cookie (",["$","code",null,{"className":"text-amber-glow","children":"arena_session"}],") to maintain your logged-in session if you are an administrator. This cookie is",["$","code",null,{"className":"text-amber-glow","children":" HttpOnly"}],",",["$","code",null,{"className":"text-amber-glow","children":" Secure"}],", and",["$","code",null,{"className":"text-amber-glow","children":" SameSite=Lax"}],". We do not use third-party tracking cookies, advertising cookies, or social media cookies."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Server logs:"}]," Our hosting provider (Vercel) and database provider (Neon) automatically log request metadata (IP, timestamp, user agent, URL). These logs are retained for 30 days for security and debugging purposes."]}]]}]
