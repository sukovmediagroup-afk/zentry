d:["$","p",null,{"children":"We may receive aggregated, non-personal information from third-party data providers we use to display real-time market data (CoinGecko), weather forecasts (Open-Meteo), and U.S. holiday calendars (Nager.Date). This information is not linked to your identity."}]
e:["$","p",null,{"children":["If you make a payment through Stripe for advertising, Stripe will collect and process your payment card information directly. We do not see or store your card number — we only receive a confirmation that the payment was successful. See"," ",["$","a",null,{"href":"https://stripe.com/privacy","target":"_blank","rel":"noopener noreferrer","className":"text-amber-glow hover:underline","children":"Stripe's Privacy Policy"}],"."]}]
f:["$","section",null,{"id":"how-we-use-information","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"2. How We Use Your Information"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We use the personal information we collect for the following business purposes:"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":"To operate, maintain, and improve our website and services (including displaying articles, counting active visitors, and personalizing weather by location)."}],["$","li",null,{"children":"To create and manage editor/administrator accounts and to authenticate your session."}],["$","li",null,{"children":"To process and publish articles submitted through our API or admin panel, including AI-assisted classification, summarization, and duplicate detection."}],["$","li",null,{"children":"To send you transactional emails (such as password reset links) when you request them. We do not send marketing emails unless you explicitly opt in."}],["$","li",null,{"children":"To process advertising orders and payments through Stripe, and to manage advertising campaigns."}],["$","li",null,{"children":"To detect, prevent, and address technical issues, fraud, security incidents, and violations of our Terms of Service."}],["$","li",null,{"children":"To comply with our legal obligations under U.S. federal and state laws, including record-keeping for audit purposes."}],["$","li",null,{"children":"To publish aggregated, de-identified analytics about visitor counts and popular categories."}]]}],["$","p",null,{"className":"mt-3","children":[["$","strong",null,{"children":"AI processing notice:"}]," We use AI models to classify and summarize article content. Article text submitted through our API is processed by these models to generate a title, summary, category, and sensitivity flags. We do not use your personal information (such as your email or IP address) for AI training."]}]]}]]}]
10:["$","section",null,{"id":"legal-basis","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"3. Legal Basis for Processing (Applicable Laws)"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We process personal information under the following legal bases, depending on the applicable jurisdiction:"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"CCPA (California):"}]," We collect and use personal information for the business and commercial purposes described above, as permitted by Cal. Civ. Code § 1798.100 et seq."]}],["$","li",null,{"children":[["$","strong",null,{"children":"VCDPA (Virginia), CPA (Colorado), CTDPA (Connecticut), UCPA (Utah):"}]," ","We process personal data for the purposes described in this Policy, consistent with the consumer rights granted under these state privacy statutes."]}],["$","li",null,{"children":[["$","strong",null,{"children":"COPPA (Children under 13):"}]," Our service is not directed at children under 13. We do not knowingly collect personal information from children under 13. If you believe we have collected such information, please contact us and we will delete it."]}],["$","li",null,{"children":[["$","strong",null,{"children":"CAN-SPAM Act:"}]," We do not send commercial email without your consent. Transactional emails (password resets) comply with CAN-SPAM requirements and include a way to contact us."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Consent:"}]," For activities that require affirmative consent (such as marketing emails), we obtain your explicit opt-in before processing."]}]]}]]}]]}]
11:["$","section",null,{"id":"sharing","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"4. How We Share Your Information"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We do not sell your personal information. We do not rent or trade your data. We share information only in the following limited circumstances:"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Service providers:"}]," We share data with the third-party service providers listed in"," ",["$","a",null,{"href":"#service-providers","className":"text-amber-glow hover:underline","children":"Section 5"}]," ","who help us operate the site. Each provider is bound by their own privacy policy and is contractually limited to using your data only to provide services to us."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Legal compliance:"}]," We may disclose information when required by law, subpoena, court order, or government request, or to protect the rights, property, or safety of ARENA USA, our users, or others."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Business transfers:"}]," If ARENA USA is involved in a merger, acquisition, or sale of assets, your information may be transferred. We will notify you by email or prominent notice on the site 30 days before any change in ownership or use of your information."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Aggregate/de-identified data:"}]," We may share aggregated, de-identified statistics about visitors (such as total monthly views or popular categories) with partners or the public. This data cannot be used to identify you."]}]]}]]}]]}]
