,{"className":"p-3","children":"N/A"}]]}],["$","tr",null,{"children":[["$","td",null,{"className":"p-3 font-medium","children":"Google Fonts"}],["$","td",null,{"className":"p-3","children":"Web fonts (Geist, Newsreader)"}],["$","td",null,{"className":"p-3","children":"IP address (sent to load fonts)"}],["$","td",null,{"className":"p-3","children":["$","a",null,{"href":"https://policies.google.com/privacy","target":"_blank","rel":"noopener noreferrer","className":"text-amber-glow hover:underline","children":"Policy"}]}]]}],"$L22","$L23"]}]]}]}],"$L24"]}]]}]
13:["$","section",null,{"id":"data-retention","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"6. Data Retention"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We retain personal information only as long as necessary for the purposes described in this Policy:"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Account information:"}]," Retained until you request deletion or your account is inactive for 24 months."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Article content:"}]," Published articles are retained for 48 hours in the public feed, then moved to the archive. Archived articles are retained indefinitely unless an administrator deletes them. Articles marked \"Pinned forever\" remain in the public feed indefinitely."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Visitor session data:"}]," Active visitor sessions are retained for 60 seconds (heartbeat TTL). Inactive session records are retained for 24 hours for analytics, then automatically deleted."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Audit logs:"}]," Retained for 24 months for security and legal compliance, then automatically deleted."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Password reset tokens:"}]," Valid for 1 hour only, then automatically invalidated."]}],["$","li",null,{"children":[["$","strong",null,{"children":"API keys:"}]," Retained until you disable or delete them through the admin panel. Usage tracking (last used, total calls) is retained for the life of the key."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Server logs (Vercel, Neon):"}]," Retained for 30 days by our hosting providers for security and debugging."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Payment records:"}]," Retained for 7 years per U.S. tax record requirements (29 CFR § 516.5). Stripe retains payment card data per their own policy — we only store campaign metadata."]}]]}]]}]]}]
14:["$","section",null,{"id":"security","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"7. Data Security"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We implement industry-standard technical and organizational measures to protect your personal information:"}],["$","ul",null,{"className":"list-disc list-inside space-y-1.5 ml-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Encryption in transit:"}]," All traffic uses HTTPS with TLS 1.3. HSTS (",["$","code",null,{"className":"text-amber-glow","children":"Strict-Transport-Security"}],") is enabled with ",["$","code",null,{"className":"text-amber-glow","children":"max-age=63072000"}]," and"," ",["$","code",null,{"className":"text-amber-glow","children":"includeSubDomains"}],"."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Encryption at rest:"}]," Database (Neon Postgres) is encrypted at rest with AES-256. Backups are encrypted."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Password hashing:"}]," Admin passwords are hashed with PBKDF2 (100,000 iterations, SHA-256, 16-byte salt). We never store plaintext passwords."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Session tokens:"}]," Session tokens are stored as SHA-256 hashes in the database, never in plaintext. If the database is compromised, stolen tokens cannot be reused."]}],["$","li",null,{"children":[["$","strong",null,{"children":"API keys:"}]," Stored as SHA-256 hashes. Raw API keys are shown only once at creation and never retrievable again."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Timing-safe comparisons:"}]," All credential comparisons (login, API key verification, cron secret) use constant-time comparison to prevent timing attacks."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Rate limiting:"}]," Login attempts, API calls, and visitor heartbeats are rate-limited to prevent brute-force and DoS attacks."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Content Security Policy (CSP):"}]," Admin pages enforce a strict CSP restricting script sources."]}],["$","li",null,{"children":[["$","strong",null,{"children":"SSRF protection:"}]," User-supplied image URLs are validated against a private-IP allowlist to prevent server-side request forgery."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Access controls:"}]," Admin panel access requires authenticated session with admin or editor role. All admin actions are logged in an audit trail."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Magic-bytes verification:"}]," Image uploads are verified by file content (not just Content-Type header) to prevent malicious file uploads."]}]]}],["$","p",null,{"className":"mt-3","children":"Despite these measures, no system is 100% secure. If we become aware of a security breach affecting your personal information, we will notify affected users within 72 hours, as required by state breach notification laws (e.g., Cal. Civ. Code § 1798.82)."}]]}]]}]
15:["$","section",null,{"id":"cookies","className":"scroll-mt-20","children":[["$","h2",null,{"className":"font-serif text-xl sm:text-2xl font-bold text-foreground mb-3 pt-6 border-t border-bronze/10 first:border-t-0 first:pt-0","children":"8. Cookies and Tracking Technologies"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"children":"We use only essential cookies. We do not use advertising cookies, social media tracking pixels, or third-party analytics cookies."}],["$","div",null,{"className":"overflow-x-auto","children":["$","table",null,{"className":"w-full text-sm border border-bronze/15 rounded-md","children":[["$","thead",null,{"className":"bg-graphite/60","children":["$","tr",null,{"children":[["$","th",null,{"className":"p-3 text-left font-medium text-muted-foreground","children":"Cookie name"}],["$","th",null,{"className":"p-3 text-left font-medium text-muted-foreground","children":"Purpose"}],["$","th",null,{"className":"p-3 text-left font-medium text-muted-foreground","children":"Duration"}],["$","th",null,{"className":"p-3 text-left font-medium text-muted-foreground","children":"Category"}]]}]}],["$","tbody",null,{"className":"divide-y divide-bronze/10","children":["$","tr",null,{"children":[["$","td",null,{"className":"p-3 font-mono text-amber-glow","children":"arena_session"}],["$","td",null,{"className":"p-3","children":"Maintains your logged-in session (admin panel only)"}],["$","td",null,{"className":"p-3","children":"7 days"}],["$","td",null,{"className":"p-3","children":"Strictly necessary"}]]}]}]]}]}],["$","p",null,{"className":"mt-3","children":["Because we only use strictly-necessary cookies, we do not display a cookie consent banner. Most browsers allow you to manage cookies in their settings — see"," ",["$","a",null,{"href":"https://support.google.com/chrome/answer/95647","target":"_blank","rel":"noopener noreferrer","className":"text-amber-glow hover:underline","children":"Chrome"}],","," ",["$","a",null,{"href":"http