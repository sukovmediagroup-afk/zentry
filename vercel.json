{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/distribute",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/poll/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/distribute/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ingest/route.ts": {
      "maxDuration": 30
    }
  }
}
