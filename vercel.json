{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/poll",
      "comment": "Daily RSS poll + archive cleanup (Hobby plan: 1 cron/day max). Pro plan: change to '*/10 * * * *'",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/distribute",
      "comment": "Daily social distribution job (Hobby plan: 1 cron/day max). Pro plan: change to '*/5 * * * *'",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/poll/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/distribute/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ingest/route.ts": {
      "maxDuration": 30
    }
  }
}
